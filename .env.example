DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

DATABASE_URL=postgresql://username:password@internal-postgres-host:5432/database_name
# Test-only database. The database name must contain "test"; never reuse DATABASE_URL.
TEST_DATABASE_URL=postgresql://bakeryflow_test:bakeryflow_test_local_only@127.0.0.1:55432/bakeryflow_test

CORS_ALLOWED_ORIGINS=https://bakemaster-erp.vercel.app
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://your-frontend.vercel.app

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
TIME_ZONE=Asia/Dubai

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CREATE_TEST_ACCOUNT=False
REPORT_XLSX_MAX_ROWS=10000
REPORT_EXPORT_SPOOL_MAX_BYTES=5242880
# Required only when CREATE_TEST_ACCOUNT=True. Store this as a secret.
TEST_ACCOUNT_PASSWORD=
